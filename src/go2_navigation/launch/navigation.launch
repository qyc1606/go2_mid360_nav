<launch>
  <!-- Deprecated compatibility wrapper. Use the canonical GO2 entry point. -->
  <arg name="map_name" default="current"/>
  <arg name="map_root" default="$(env HOME)/go2_mid360_nav/maps"/>
  <arg name="start_lidar" default="true"/>

  <include file="$(find go2_system_bringup)/launch/go2_navigation.launch">
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="map_root" value="$(arg map_root)"/>
    <arg name="start_lidar" value="$(arg start_lidar)"/>
  </include>
</launch>
