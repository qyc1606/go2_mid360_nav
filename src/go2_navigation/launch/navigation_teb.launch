<launch>

  <arg name="map_name" default="current" />
  <arg name="map_root" default="$(env HOME)/go2_mid360_nav/maps" />
  <arg name="odom_topic" default="/odom_nav" />
  <arg name="obstacle_cloud_topic" default="/cloud_registered_base" />

  <arg
      name="map_dir"
      default="$(arg map_root)/$(arg map_name)" />

  <arg
      name="nav_map_yaml"
      default="$(arg map_dir)/map_raw.yaml" />

  <!-- 1. 导航专用 raw 静态地图 -->
  <node
      pkg="map_server"
      type="map_server"
      name="go2_navigation_map_server"
      args="$(arg nav_map_yaml)"
      output="screen">

    <remap from="map" to="/map_2d" />
    <remap from="map_metadata" to="/map_2d_metadata" />

  </node>

  <!-- 2. move_base + TEB -->
  <node
      pkg="move_base"
      type="move_base"
      name="move_base"
      output="screen">

    <rosparam
        command="load"
        file="$(find go2_navigation)/config/move_base_teb.yaml" />

    <rosparam
        command="load"
        ns="global_costmap"
        file="$(find go2_navigation)/config/costmap_common.yaml" />

    <rosparam
        command="load"
        ns="global_costmap"
        file="$(find go2_navigation)/config/global_costmap.yaml" />

    <rosparam
        command="load"
        ns="local_costmap"
        file="$(find go2_navigation)/config/costmap_common.yaml" />

    <rosparam
        command="load"
        ns="local_costmap"
        file="$(find go2_navigation)/config/local_costmap.yaml" />

    <rosparam
        command="load"
        file="$(find go2_navigation)/config/global_planner.yaml" />

    <rosparam
        command="load"
        file="$(find go2_navigation)/config/teb_local_planner.yaml" />

    <!-- 可通过 launch 参数覆盖 PointCloud2 障碍源 -->
    <param
        name="local_costmap/obstacle_layer/fastlio_cloud/topic"
        value="$(arg obstacle_cloud_topic)" />

    <remap from="odom" to="$(arg odom_topic)" />
    <remap from="cmd_vel" to="/cmd_vel_nav" />

  </node>

  <include file="$(find go2_cmd_watchdog)/launch/watchdog.launch" />

</launch>
