<launch>
  <arg name="map_name" default="current"/>
  <arg name="map_root" default="$(env HOME)/go2_mid360_nav/maps"/>
  <arg name="map_pcd" default="$(arg map_root)/$(arg map_name)/public_map.pcd"/>

  <node pkg="fast_lio_localization" type="map_loader" name="map_loader" output="screen">
    <param name="map_path" value="$(arg map_pcd)"/>
  </node>
  <node pkg="fast_lio_localization" type="fast_lio_localization"
        name="fast_lio_localization" output="screen">
    <param name="map_frame" value="map"/>
    <param name="odom_frame" value="odom"/>
    <param name="base_frame" value="base_link"/>
    <param name="cloud_topic" value="/cloud_registered_base"/>
    <param name="odom_topic" value="/odom_nav"/>
    <param name="localization_topic" value="/localization"/>
    <param name="health_topic" value="/localization/ok"/>
    <param name="tf_postdate_sec" value="0.50"/>
    <param name="ndt/max_fitness_score" value="2.0"/>
    <param name="ndt/max_translation_jump" value="0.8"/>
    <param name="ndt/max_rotation_jump" value="0.349066"/>
    <param name="ndt/max_alignment_age_sec" value="1.0"/>
  </node>
  <include file="$(find go2_localization_guard)/launch/guard.launch"/>
</launch>
