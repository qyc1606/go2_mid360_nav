# ----- GO2 Ethernet -----
export GO2_IFACE=eth0
export GO2_HOST_IP=192.168.123.99

# ----- MID-360 Ethernet -----
export LIVOX_IFACE=eth1
export LIVOX_HOST_IP=192.168.1.50

# 必须改成你自己的 MID-360 实际 IP
export MID360_IP=192.168.1.191
# ----- D435i -----
# 可先留空；获得序列号后写入，例如 123456789012
export D435I_SERIAL=""

# ----- Map -----
export GO2_MAP_NAME=site01
