<launch>

    <!-- GO2 + Livox Mid-360 FAST-LIO Localization -->

    <arg name="rviz" default="true" />

    <arg name="map"
         default="/home/nvidia/go2_mid360_nav/maps/corridor_01/public_map.pcd" />

    <!-- Mid-360 FAST-LIO parameters -->
    <rosparam command="load"
              file="$(find fast_lio_localization)/config/go2_mid360.yaml" />

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="1"/>
    <param name="max_iteration" type="int" value="3"/>
    <param name="filter_size_surf" type="double" value="0.5"/>
    <param name="filter_size_map" type="double" value="0.5"/>
    <param name="cube_side_length" type="double" value="1000"/>
    <param name="runtime_pos_log_enable" type="bool" value="0"/>
    <param name="pcd_save_enable" type="bool" value="0"/>

    <!-- FAST-LIO local odometry -->
    <node pkg="fast_lio_localization"
          type="fastlio_mapping"
          name="laserMapping"
          output="screen" />

    <!-- Scan-to-map global localization -->
    <node pkg="fast_lio_localization"
          type="global_localization.py"
          name="global_localization"
          output="screen" />

    <!-- map + FAST-LIO odometry fusion -->
    <node pkg="fast_lio_localization"
          type="transform_fusion.py"
          name="transform_fusion"
          output="screen" />

    <!-- Saved global PCD -->
    <node pkg="pcl_ros"
          type="pcd_to_pointcloud"
          name="map_publisher"
          output="screen"
          args="$(arg map) 5 _frame_id:=map cloud_pcd:=/map" />

    <group if="$(arg rviz)">
        <node launch-prefix="nice"
              pkg="rviz"
              type="rviz"
              name="rviz"
              args="-d $(find fast_lio_localization)/rviz_cfg/localization.rviz" />
    </group>

</launch>
