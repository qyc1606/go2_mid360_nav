<launch>
  <param name="/use_sim_time" value="false"/>

  <rosparam file="$(find go2_bringup)/config/fast_lio/mid360_mapping.yaml"
            command="load"/>

  <!-- Internal FAST-LIO PCD is in lio_odom. V8 public map saving should
       use go2_map_accumulator on /cloud_registered_odom instead. -->
  <param name="pcd_save/pcd_save_en" value="false"/>

  <node pkg="fast_lio"
        type="fastlio_mapping"
        name="laserMapping"
        output="screen">
    <!-- Isolate all estimator-facing output topics under /lio. -->
    <remap from="/Odometry" to="/lio/odometry"/>
    <remap from="/cloud_registered" to="/lio/cloud_registered"/>
    <remap from="/cloud_registered_body" to="/lio/cloud_registered_body"/>
    <remap from="/Laser_map" to="/lio/laser_map"/>
    <remap from="/path" to="/lio/path"/>
  </node>
</launch>
